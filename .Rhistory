ds_fat2 <- ds1 %>%
group_by(ID_fish, Temp_class, Sex, Fat_mass_g, log_fatmass, log_finalmass_centre, finalmass_centre, Final_Mass_g) %>%
summarise(
sum_SMR = sum(SMR, na.rm = TRUE),
mean_SMR = mean(SMR, na.rm = TRUE),
sum_RMR = sum(RMR, na.rm = TRUE),
mean_RMR = mean(RMR, na.rm = TRUE),
sum_MMR = sum(MMR, na.rm = TRUE),
mean_MMR = mean(MMR, na.rm = TRUE)
) %>% drop_na()
density <- ds1[which(ds1$Month == "September"),] %>% dplyr::select(ID_fish, Density)
ds_fat2 <- left_join(ds_fat2, density, by = c("ID_fish"))
ds_fat2 <- ds_fat2[which(ds_fat2$ID_fish != 99),] #Fish 99 is a clear outlier in the diagnostic plots, I will test these models with and without it
fat_mod_sumSMR <- lm(log_fatmass ~ Temp_class + log_finalmass_centre:Temp_class + sum_SMR:Temp_class + Sex + Density, data=ds_fat2)
fat_mod_sumRMR <- lm(log_fatmass ~ Temp_class + log_finalmass_centre:Temp_class + sum_RMR:Temp_class + Sex + Density, data=ds_fat2)
fat_mod_sumMMR <- lm(log_fatmass ~ Temp_class + log_finalmass_centre:Temp_class + sum_MMR:Temp_class + Sex + Density, data=ds_fat2)
fat_mod_meanSMR <- lm(log_fatmass ~ Temp_class + log_finalmass_centre:Temp_class + mean_SMR:Temp_class + Sex + Density, data=ds_fat2)
fat_mod_meanRMR <- lm(log_fatmass ~ Temp_class + log_finalmass_centre:Temp_class + mean_RMR:Temp_class + Sex + Density, data=ds_fat2)
fat_mod_meanMMR <- lm(log_fatmass ~ Temp_class + log_finalmass_centre:Temp_class + mean_MMR:Temp_class + Sex + Density, data=ds_fat2)
